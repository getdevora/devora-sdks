{
	"name": "@devorash/solid",
	"version": "0.1.1",
	"description": "Devora Solid.js SDK - primitives for impersonation",
	"keywords": [
		"devora",
		"impersonation",
		"primitives",
		"sdk",
		"solid",
		"solidjs",
		"support"
	],
	"homepage": "https://docs.devora.sh/reference/packages",
	"bugs": {
		"url": "https://github.com/getdevora/devora-sdks/issues"
	},
	"license": "MIT",
	"author": "Devora",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getdevora/devora-sdks.git",
		"directory": "solid"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"solid": "./src/index.tsx",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc && node scripts/compile-jsx.mjs",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@devorash/browser": "workspace:*",
		"@devorash/core": "workspace:*"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"babel-preset-solid": "^1.9.12",
		"solid-js": "^1.9.13",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"solid-js": "^1.7.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
