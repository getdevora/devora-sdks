{
	"name": "@devorash/nextjs",
	"version": "0.1.2",
	"description": "Devora Next.js adapter — App Router route handlers, scope guard, and client provider",
	"keywords": [
		"app-router",
		"backend",
		"devora",
		"impersonation",
		"next",
		"nextjs",
		"sdk"
	],
	"homepage": "https://docs.devora.sh/reference/packages",
	"bugs": {
		"url": "https://github.com/getdevora/devora-sdks/issues"
	},
	"license": "MIT",
	"author": "Devora",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getdevora/devora-sdks.git",
		"directory": "nextjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@devorash/core": "workspace:*",
		"@devorash/node": "workspace:*",
		"@devorash/react": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"react": "^19.2.7",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"next": ">=14.0.0 <17",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
