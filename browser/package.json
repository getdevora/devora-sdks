{
	"name": "@devorash/browser",
	"version": "0.1.0",
	"description": "Devora Frontend JavaScript SDK for secure impersonation",
	"keywords": [
		"browser",
		"customer-support",
		"devora",
		"frontend",
		"impersonation",
		"sdk",
		"support"
	],
	"homepage": "https://docs.devora.sh/reference/packages",
	"bugs": {
		"url": "https://github.com/getdevora/devora-sdks/issues"
	},
	"license": "MIT",
	"author": "Devora",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getdevora/devora-sdks.git",
		"directory": "browser"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@devorash/core": "workspace:*",
		"@rrweb/rrweb-plugin-console-record": "2.0.1",
		"css-tree": "3.2.1",
		"fflate": "^0.8.3",
		"rrweb": "2.0.1"
	},
	"devDependencies": {
		"@types/css-tree": "3.2.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
