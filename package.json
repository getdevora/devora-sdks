{
	"name": "devora-sdks",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"core",
		"node",
		"browser",
		"express",
		"fastify",
		"hono",
		"react",
		"vue",
		"svelte",
		"solid",
		"nextjs"
	],
	"scripts": {
		"build:sdks": "turbo build --filter='@devorash/*'",
		"check-types:sdks": "turbo check-types --filter='@devorash/*'",
		"test:sdks": "bun run build:sdks && bun test test && node scripts/check-bundle-size.mjs",
		"test:python-sdks": "uv run --no-project --with 'pytest==9.0.2' --with 'fastapi==0.135.1' --with 'httpx==0.28.1' --with 'django==5.2.12' pytest -q python/tests",
		"verify:sdks-publish": "node scripts/verify-publish-tarballs.mjs",
		"verify:python-publish": "node scripts/verify-python-publish.mjs",
		"smoke:sdks-publish": "node scripts/smoke-test-npm-artifacts.mjs",
		"version:sdks": "changeset version && node scripts/sync-sdk-version.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"fflate": "^0.8.3",
		"hono": "^4.13.5",
		"svelte": "^5.56.4",
		"turbo": "^2.10.13",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"@babel/core": "^7.29.6",
		"ajv": "^8.20.0",
		"baseline-browser-mapping": "^2.11.0",
		"body-parser": "^2.3.0",
		"devalue": "^5.8.1",
		"fast-uri": "^4.1.3",
		"find-my-way": "^9.9.0",
		"hono": "^4.13.5",
		"js-yaml": "^4.3.2",
		"nanoid": "3.3.18",
		"path-to-regexp": "^8.4.2",
		"picomatch": "^4.0.4",
		"postcss": "^8.5.26",
		"qs": "^6.16.0",
		"seroval": "^1.5.4",
		"solid-js": "^1.9.13",
		"svelte": "^5.56.4"
	},
	"engines": {
		"node": ">=22.0.0 <23.0.0"
	},
	"packageManager": "bun@1.3.14"
}
