{
	"name": "@devorash/express",
	"version": "0.1.2",
	"description": "Devora Express.js adapter for backend SDK",
	"keywords": [
		"backend",
		"devora",
		"express",
		"impersonation",
		"sdk"
	],
	"homepage": "https://docs.devora.sh/reference/packages",
	"bugs": {
		"url": "https://github.com/getdevora/devora-sdks/issues"
	},
	"license": "MIT",
	"author": "Devora",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getdevora/devora-sdks.git",
		"directory": "express"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@devorash/core": "workspace:*",
		"@devorash/node": "workspace:*"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.0.1",
		"express": "^5.2.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"express": "^4.18.0 || ^5.0.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
